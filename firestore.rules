rules_version = '2';

// =====================================================================
// Rounds/Wards — hospital > department > ward-group access control for
// the unified, department-tagged patient system (Wards' single Patients
// tab covers General/ICU/Surgery/Pediatrics/Maternity via a `department`
// field on each patient doc — previously two independent group systems,
// vitalsGroups and maternityGroups, now collapsed into one).
//
// Three-tier hierarchy:
//   Hospital super-admin  — `users/{uid}.superAdmin == true`. Sees/manages
//     every department and every ward group. Bootstrapped manually once
//     (see README-FIRESTORE-SETUP.md), then can promote/demote others and
//     create departments from within the app.
//   Department admin      — listed in a `departments/{deptId}.admins` map.
//     Sees/manages every ward group tagged with that department's id, but
//     nothing outside it.
//   Ward-group admin       — whoever creates a wardGroups doc becomes its
//     admin automatically (server-enforced, not just client convention).
//     Can invite/remove members, rename, or delete just that one group. A
//     group may optionally belong to a department (`departmentId` field)
//     or stand alone with no department at all.
//
// Security model: every level of membership above is enforced server-side
// here, not just hidden in the UI — someone who isn't a member (and isn't
// a department admin for that group's department, and isn't a super-admin)
// cannot read or write anything under a group, regardless of what the
// client app does or doesn't show them.
//
// Schema:
//   users/{uid}                        { email, displayName, superAdmin }
//   usersByEmail/{emailKey}             { uid }   — invite-by-email lookup
//   departments/{deptId}                { name, createdBy, createdAt, admins: { [uid]: {role:'admin', email, joinedAt} } }
//   wardGroups/{groupId}                { name, createdBy, createdAt, departmentId (nullable), members: { [uid]: {role, email, joinedAt} } }
//   wardGroups/{groupId}/patients/{id}  — the actual patient records; each
//     carries its own `department` field ('general'|'icu'|'surgery'|
//     'pediatrics'|'maternity') picking which charting sections the app
//     shows for it — a per-patient tag, not a separate collection, since
//     one ward group can hold patients from any mix of departments.
//   wardGroups/{groupId}/invites/{emailKey}  { email, invitedBy, invitedAt } — pending invite for a not-yet-registered email
//   groupMemberships/{uid}_{groupId}    { uid, groupId, role, groupName, joinedAt }
//     — a flat join-collection purely so a signed-in user can list "which
//     groups am I in" via a simple `where('uid','==',myUid)` query
//     (Firestore can't query "does this map have key X" directly, and
//     rules can only accept a `list` query that's provably constrained
//     the same way the rule checks it — an equality filter on `uid` is
//     exactly that). The group doc's own `members` map stays the single
//     source of truth for actual access control; this collection is a
//     read-side index only, kept in sync by whichever client write
//     creates/removes a membership (always in the same batched write).
//     `departmentId` on wardGroups is a plain field (not a map key), so
//     "all groups in my department" is a normal `where('departmentId','==',
//     deptId)` equality query — no join collection needed for that one.
// =====================================================================

function signedIn() {
  return request.auth != null;
}

function isSuperAdmin() {
  return signedIn()
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superAdmin == true;
}

function departmentDoc(deptId) {
  return /databases/$(database)/documents/departments/$(deptId);
}

function isDepartmentAdmin(deptId) {
  return signedIn() && deptId != null
    && exists(departmentDoc(deptId))
    && (request.auth.uid in get(departmentDoc(deptId)).data.admins);
}

function isValidNewDepartment() {
  return signedIn()
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.admins.keys().hasOnly([request.auth.uid])
    && request.resource.data.admins[request.auth.uid].role == 'admin';
}

function groupDoc(groupId) {
  return /databases/$(database)/documents/wardGroups/$(groupId);
}

function isMemberPath(groupPath) {
  return signedIn() && exists(groupPath) && (request.auth.uid in get(groupPath).data.members);
}

function isGroupAdminPath(groupPath) {
  return signedIn() && exists(groupPath)
    && (request.auth.uid in get(groupPath).data.members)
    && get(groupPath).data.members[request.auth.uid].role == 'admin';
}

// Anyone above ward-admin level who can also reach in: the group's own
// department admin, or the hospital super-admin.
function isAboveGroupPath(groupPath) {
  return isSuperAdmin()
    || (exists(groupPath) && get(groupPath).data.departmentId != null
        && isDepartmentAdmin(get(groupPath).data.departmentId));
}

// A brand-new group document must name its creator as its sole initial
// member, with the admin role — this is what makes "creator becomes
// admin" a server-enforced fact rather than something the client merely
// claims. If it's being created under a department (departmentId set),
// the creator must actually be that department's admin (or the hospital
// super-admin) — otherwise anyone could tag a group as belonging to a
// department they have no authority over.
function isValidNewGroup() {
  return signedIn()
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.members.keys().hasOnly([request.auth.uid])
    && request.resource.data.members[request.auth.uid].role == 'admin'
    && (
      !('departmentId' in request.resource.data) || request.resource.data.departmentId == null
      || isDepartmentAdmin(request.resource.data.departmentId)
      || isSuperAdmin()
    );
}

match /databases/{database}/documents {

  // ---- user profiles ----
  // Each signed-in user has exactly one profile doc, keyed by their own
  // uid. They can read their own profile; only an existing super-admin
  // can read someone else's, or grant/revoke the superAdmin flag on
  // ANYONE's profile (a user flipping their own `superAdmin` field must
  // be blocked, including at creation time).
  match /users/{uid} {
    allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
    allow create: if signedIn() && request.auth.uid == uid
      && request.resource.data.superAdmin == false;
    allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.superAdmin == resource.data.superAdmin)
        || isSuperAdmin()
      );
    allow delete: if isSuperAdmin();
  }

  // Invite-by-email lookup (email -> uid). Not sensitive beyond the
  // mapping itself; a user may only write their own mapping (done once
  // at sign-up), and any signed-in user may read it (needed so a group
  // admin can resolve "invite this email" client-side).
  match /usersByEmail/{emailKey} {
    allow read: if signedIn();
    allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
  }

  // ---- departments ----
  match /departments/{deptId} {
    allow get: if isDepartmentAdmin(deptId) || isSuperAdmin();
    allow list: if signedIn(); // each returned doc still individually checked against `get` above
    allow create: if isValidNewDepartment();
    allow update: if isDepartmentAdmin(deptId) || isSuperAdmin();
    allow delete: if isSuperAdmin(); // deleting a whole department is hospital-level only, not a department admin's own call
  }

  // ---- the read-side "my groups" index ----
  // Document id convention: `${uid}_${groupId}`. Only ever read via a
  // `where('uid','==', request.auth.uid)` query from the app (that's
  // what lets Firestore accept the `list` rule below); a super-admin may
  // read any of them for the admin console.
  match /groupMemberships/{membershipId} {
    allow read: if signedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    allow list: if signedIn(); // scoping happens via the required uid-equality query, enforced by `read` above per returned doc
    // Only created/deleted as part of the *same batched write* that adds
    // or removes the uid from the corresponding group's `members` map —
    // so whoever is allowed to make that group change is allowed here too.
    allow create: if signedIn()
      && request.resource.data.uid is string
      && (
        isGroupAdminPath(groupDoc(request.resource.data.groupId))
        || isAboveGroupPath(groupDoc(request.resource.data.groupId))
        || isSuperAdmin()
      );
    allow delete: if signedIn()
      && (
        resource.data.uid == request.auth.uid // anyone can remove themselves (leave a group)
        || isGroupAdminPath(groupDoc(resource.data.groupId))
        || isAboveGroupPath(groupDoc(resource.data.groupId))
        || isSuperAdmin()
      );
  }

  // ---- Ward groups (single system — patients within carry their own
  // `department` field rather than living in a department-specific
  // collection, so one ward group can hold patients from any mix of
  // General/ICU/Surgery/Pediatrics/Maternity) ----
  match /wardGroups/{groupId} {
    allow get: if isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
      || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
    allow list: if signedIn(); // each returned doc still individually checked against `get` above (also how a dept admin's "all groups in my department" query gets scoped)
    allow create: if isValidNewGroup();
    allow update: if isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
      || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
    allow delete: if isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
      || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));

    match /patients/{patientId} {
      allow read, write: if isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
    }
    match /invites/{emailKey} {
      allow read: if signedIn() && (
        resource.data.email == request.auth.token.email
        || isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId))
      );
      allow list: if signedIn(); // a newly-registered user scans for invites matching their own email client-side
      allow create, delete: if isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
    }
  }

  // Default deny for anything not explicitly matched above.
  match /{document=**} {
    allow read, write: if false;
  }
}
