rules_version = '2';

// =====================================================================
// Rounds/Wards -- multi-hospital, hospital > department > ward-group
// access control for the unified, department-tagged patient system
// (Wards' single Patients tab covers General/ICU/Surgery/Pediatrics/
// Maternity via a `department` field on each patient doc -- previously
// two independent group systems, vitalsGroups and maternityGroups, now
// collapsed into one).
//
// This is a single shared Firebase project (`wards-a4e41`) serving MANY
// independent hospitals at once. There is no global "super-admin" who
// can see across hospitals -- each hospital is its own fully isolated
// tenant, and admin authority never crosses a `hospitalId` boundary.
//
// Four-tier hierarchy:
//   Hospital admin        -- listed in a `hospitals/{hospitalId}.admins`
//     map. Sees/manages every department and every ward group that
//     belongs to that specific hospital (via their `hospitalId` field),
//     and nothing belonging to any other hospital. Self-service: any
//     signed-in user can create a new hospital and automatically
//     becomes its sole admin (server-enforced) -- this is the entire
//     bootstrap process; there is no manual console step anymore.
//   Department admin      -- listed in a `departments/{deptId}.admins`
//     map. Sees/manages every ward group tagged with that department's
//     id, but nothing outside it. A department always belongs to
//     exactly one hospital (`hospitalId` field, required, immutable in
//     practice since rules don't allow changing which hospital a doc
//     belongs to via a plain field update check -- see isValidNewDepartment).
//   Ward-group admin       -- whoever creates a wardGroups doc becomes its
//     admin automatically (server-enforced, not just client convention).
//     Can invite/remove members, rename, or delete just that one group. A
//     group may optionally belong to a department (`departmentId` field)
//     but ALWAYS belongs to exactly one hospital (`hospitalId` field,
//     required) -- even a group with no department still needs to be
//     reachable by its hospital's admin, so hospital scoping is never
//     only reachable *through* a department.
//   Ward-group member      -- anyone added to a `wardGroups/{groupId}.members`
//     map by an admin at or above that group.
//
// Security model: every level of membership above is enforced server-side
// here, not just hidden in the UI -- someone who isn't a member (and isn't
// a department admin for that group's department, and isn't an admin of
// the hospital that group/department belongs to) cannot read or write
// anything under a group, regardless of what the client app does or
// doesn't show them. Critically: a hospital admin's reach is *computed
// from the target document's own `hospitalId` field*, not from any
// client-supplied claim -- so Hospital A's admin can never read or write
// Hospital B's departments or ward groups, because isAboveGroupPath/
// isAboveDeptPath always re-derive the owning hospital from the stored
// document and check membership in THAT hospital's admins map only.
//
// Schema:
//   users/{uid}                        { email, displayName, agreedToTermsVersion, agreedAt }
//     -- no global role flag of any kind lives here anymore; all
//     authority is scoped per-hospital via hospitals/{id}.admins.
//     agreedToTermsVersion/agreedAt record acceptance of the Terms of
//     Use / Privacy Policy gate shown after sign-in (see wards.html's
//     WARDS_TERMS_VERSION); a mismatch against the app's current
//     version constant re-prompts the user on next sign-in.
//   usersByEmail/{emailKey}             { uid }   -- invite-by-email lookup
//   hospitals/{hospitalId}              { name, createdBy, createdAt, admins: { [uid]: {role:'admin', email, joinedAt} },
//                                          stripeCustomerId, stripeSubscriptionId, subscriptionStatus, currentPeriodEnd }
//     -- the tenancy root. Creating one is how a user becomes its sole
//     admin; there is no other way to gain hospital-admin authority
//     (mirrors departments/wardGroups: creator-becomes-admin is
//     server-enforced by isValidNewHospital, not a client claim).
//     -- the billing fields are written ONLY by the stripeWebhook Cloud
//     Function (functions/index.js), using the Admin SDK, which bypasses
//     these rules entirely -- no client write path ever sets
//     subscriptionStatus, so a user can never grant themselves the paid
//     tier by crafting a request. See isValidNewDepartment() below for
//     where subscriptionStatus is actually enforced.
//   departments/{deptId}                { name, hospitalId, createdBy, createdAt, admins: { [uid]: {role:'admin', email, joinedAt} } }
//   wardGroups/{groupId}                { name, hospitalId, createdBy, createdAt, departmentId (nullable), members: { [uid]: {role, email, joinedAt} } }
//   wardGroups/{groupId}/patients/{id}  -- the actual patient records; each
//     carries its own `department` field ('general'|'icu'|'surgery'|
//     'pediatrics'|'maternity') picking which charting sections the app
//     shows for it -- a per-patient tag, not a separate collection, since
//     one ward group can hold patients from any mix of departments.
//   wardGroups/{groupId}/invites/{emailKey}  { email, invitedBy, invitedAt } -- pending invite,
//     doc id is the lowercased invitee email (emailKey == email.trim().toLowerCase(),
//     enforced on create so the doc id can be trusted as a proxy for its own
//     `email` field elsewhere, e.g. isValidInviteAccept below). Created by a group
//     admin/above; the invitee has never been a member yet so has no standing
//     access to this subcollection to browse it directly (see pendingInvites).
//   wardGroups/{groupId}/auditLog/{entryId}  { action, patientId, patientName, detail, uid, email, ts }
//     -- append-only audit trail. Any member can create an entry (Wards does,
//     for patient add/remove, a new vitals reading, and an escalation
//     logged); nobody can update one once written, and delete is
//     restricted to that group's owning hospital's admin (no global
//     super-admin exists to fall back to). Readable by a group admin or
//     above (via the existing isGroupAdminPath/isAboveGroupPath helpers)
//     -- a rank-and-file member can write history but not browse it,
//     matching "who did what" being an oversight tool rather than a
//     general-purpose feed.
//   wardGroups/{groupId}/chat/{msgId}   { text, senderUid, senderName, sentAt }
//     -- this ward group's own text chat. Same membership check as
//     patients/; immutable once posted (no update/delete in v1).
//   departments/{deptId}/chat/{msgId}   { text, senderUid, senderName, sentAt }
//     -- department-wide chat, shared by every ward group under it.
//     Readable/writable by isDepartmentMember() (see that function) or
//     a department/hospital admin.
//   departments/{deptId}/announcements/{annId}  { text, postedBy, postedByName, postedAt }
//     -- one-way admin broadcast to the same audience as chat above,
//     but only a department/hospital admin can post one.
//   departmentMemberships/{uid}_{deptId}  { uid, deptId, joinedAt }
//     -- flat join-index mirroring groupMemberships below, purely so
//     isDepartmentMember() can do a cheap exists() check instead of an
//     un-expressible "member of any group under this department" query.
//     Written in the same batch as wardsCreateGroup/wardsAcceptInvite
//     whenever the group being joined/created has a departmentId.
//   groupMemberships/{uid}_{groupId}    { uid, groupId, role, groupName, joinedAt }
//     -- a flat join-collection purely so a signed-in user can list "which
//     groups am I in" via a simple `where('uid','==',myUid)` query
//     (Firestore can't query "does this map have key X" directly, and
//     rules can only accept a `list` query that's provably constrained
//     the same way the rule checks it -- an equality filter on `uid` is
//     exactly that). The group doc's own `members` map stays the single
//     source of truth for actual access control; this collection is a
//     read-side index only, kept in sync by whichever client write
//     creates/removes a membership (always in the same batched write).
//     `departmentId` on wardGroups is a plain field (not a map key), so
//     "all groups in my department" is a normal `where('departmentId','==',
//     deptId)` equality query -- no join collection needed for that one.
//   pendingInvites/{inviteId}           { email, groupId, groupName, hospitalId, invitedBy, invitedByEmail, invitedAt }
//     -- a flat join-collection for the same reason groupMemberships is
//     flat: an invited user isn't a member of the group yet, so has no
//     way to know which `wardGroups/{groupId}/invites/{emailKey}`
//     subcollection to even look under, and Firestore doesn't support a
//     safely-rulable collection-group query here. Doc id convention:
//     `${groupId}_${emailKey}` (emailKey == email.trim().toLowerCase()).
//     Created by the SAME batched write that creates the matching
//     wardGroups/{groupId}/invites/{emailKey} doc; deleted (by either
//     side) in the same batch as that doc too -- see isValidInviteAccept
//     and wardsInviteToGroup/wardsAcceptInvite/wardsDeclineInvite in
//     wards.html. The invites subcollection doc remains the actual
//     authorization source; this collection is a read-side index only,
//     queried via `.where('email','==', myEmail.toLowerCase())`.
// =====================================================================

service cloud.firestore {

function signedIn() {
  return request.auth != null;
}

function hospitalDoc(hospitalId) {
  return /databases/$(database)/documents/hospitals/$(hospitalId);
}

function isHospitalAdmin(hospitalId) {
  return signedIn() && hospitalId != null
    && exists(hospitalDoc(hospitalId))
    && (request.auth.uid in get(hospitalDoc(hospitalId)).data.admins);
}

function isValidNewHospital() {
  return signedIn()
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.admins.keys().hasOnly([request.auth.uid])
    && request.resource.data.admins[request.auth.uid].role == 'admin';
}

function departmentDoc(deptId) {
  return /databases/$(database)/documents/departments/$(deptId);
}

function isDepartmentAdmin(deptId) {
  return signedIn() && deptId != null
    && exists(departmentDoc(deptId))
    && (request.auth.uid in get(departmentDoc(deptId)).data.admins);
}

// A department admin, OR the admin of the hospital this department
// belongs to (read from the department's own stored `hospitalId` --
// never from anything the request itself supplies).
function isAboveDeptPath(deptId) {
  return exists(departmentDoc(deptId))
    && isHospitalAdmin(get(departmentDoc(deptId)).data.hospitalId);
}

// Whether the caller is a MEMBER (not necessarily admin) of some ward
// group that belongs to this department -- used to gate the
// department-wide chat/announcements to "everyone actually working in
// this department," not just its admins. Departments have no `members`
// map of their own (only `admins`), so this reads the flat
// departmentMemberships/{uid}_{deptId} index instead -- same
// "denormalized flat index, kept in sync by whichever write already has
// permission to touch the real membership" pattern as groupMemberships,
// see wardsCreateGroup/wardsAcceptInvite in wards.html for where it's
// written.
function isDepartmentMember(deptId) {
  return signedIn() && deptId != null
    && exists(/databases/$(database)/documents/departmentMemberships/$(request.auth.uid + '_' + deptId));
}

// Departments are the paid-tier feature: a hospital's first ward group
// (created directly under the hospital, no department needed) always
// stays free -- multi-department organization is what needs an active
// subscription. subscriptionStatus is written server-side only, by the
// stripeWebhook Cloud Function (see functions/index.js); nothing here
// ever trusts a client-supplied value for it.
function isValidNewDepartment() {
  return signedIn()
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.admins.keys().hasOnly([request.auth.uid])
    && request.resource.data.admins[request.auth.uid].role == 'admin'
    && request.resource.data.hospitalId is string
    && isHospitalAdmin(request.resource.data.hospitalId)
    && get(hospitalDoc(request.resource.data.hospitalId)).data.get('subscriptionStatus', '') == 'active';
}

function groupDoc(groupId) {
  return /databases/$(database)/documents/wardGroups/$(groupId);
}

function userDoc(uid) {
  return /databases/$(database)/documents/users/$(uid);
}

// ---- OPD (outpatient) access control ----
// OPD deliberately does NOT reuse departmentMemberships/wardGroups: those
// model "which ward group(s) is this person in" for INPATIENT charting,
// where a patient's data lives inside one specific group. OPD's whole
// point is the opposite -- one patient record shared hospital-wide, with
// every department's visits visible together (see wards.html's OPD
// module) -- so what OPD actually needs is a single per-user "which
// hospital, which department" assignment, not group membership.
//
// That assignment lives directly on the user's own profile doc
// (users/{uid}.opdHospitalId / .opdDepartment) specifically so it can be
// admin-controlled: see the isValidOpdAssignmentUpdate branch on
// `match /users/{uid}` below, which is the ONLY way those two fields can
// ever change, and only a hospital admin can invoke it (never the user
// themselves) -- "assigned by hospital admin," not user self-service.
function isOpdMember(hospitalId) {
  return signedIn() && hospitalId != null
    && exists(userDoc(request.auth.uid))
    && get(userDoc(request.auth.uid)).data.get('opdHospitalId', null) == hospitalId;
}

// The department a signed-in OPD member is currently assigned to (null
// if they aren't an OPD member of any hospital at all). Only meaningful
// after isOpdMember() has already confirmed the doc exists.
function opdMemberDepartment() {
  return get(userDoc(request.auth.uid)).data.get('opdDepartment', null);
}

// Whether the CALLER (never a client-supplied uid/email -- always the
// requester's own verified auth token email) has a pending invite to
// this group. Doc id is the lowercased email, enforced at invite-create
// time (see wardGroups/{groupId}/invites/{emailKey} rules below), so
// checking existence at this exact path is sufficient proof -- nobody
// else can plant a doc at a path keyed by someone else's token email.
function callerHasInviteFor(groupId) {
  return signedIn()
    && exists(/databases/$(database)/documents/wardGroups/$(groupId)/invites/$(request.auth.token.email.lower()));
}

// The ONE server-authorized way a user who is NOT YET a member can
// modify a wardGroups doc: accepting their own pending invite. Every
// condition here is load-bearing -- see the attack-scenario walkthrough
// in the commit that introduced this function.
//   (a) not already a member -- an existing member (even one just
//       demoted) can't re-enter through this narrower door; the normal
//       admin-only branch of the update rule governs them instead.
//   (b) callerHasInviteFor(groupId) is the actual authorization: proof
//       a group admin/above genuinely invited THIS caller's own email
//       (never a client-supplied claim).
//   (c) request.resource.data.diff(resource.data).affectedKeys() must
//       be exactly {'members'} -- no OTHER top-level field (name,
//       hospitalId, departmentId, createdBy, createdAt, ...) may change
//       in this write. This is what stops an invite-accept from also
//       renaming the group or re-parenting it to another hospital.
//   (d) within `members`, the diff's affected keys must be exactly the
//       caller's own uid -- this blocks touching (adding, removing, OR
//       modifying) any OTHER member's entry in the same write, and
//       since (a) already established the caller's uid isn't currently
//       a key, this key can only be an ADDITION, never an overwrite.
//   (e) the new entry's role must be literally 'member' -- never
//       'admin' or anything else -- so an invite can never silently
//       grant admin authority.
function isValidInviteAccept(groupPath, groupId) {
  return signedIn()
    && exists(groupPath)
    && !(request.auth.uid in get(groupPath).data.members)
    && callerHasInviteFor(groupId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
    && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
    && request.resource.data.members[request.auth.uid].role == 'member';
}

function isMemberPath(groupPath) {
  return signedIn() && exists(groupPath) && (request.auth.uid in get(groupPath).data.members);
}

function isGroupAdminPath(groupPath) {
  return signedIn() && exists(groupPath)
    && (request.auth.uid in get(groupPath).data.members)
    && get(groupPath).data.members[request.auth.uid].role == 'admin';
}

// Anyone above ward-admin level who can also reach in: the group's own
// department admin, or the admin of the hospital the group itself
// belongs to (via the group's own required `hospitalId` -- this is what
// makes a standalone group with no department still reachable by its
// hospital's admin, rather than hospital scoping only working through
// a department). Both branches re-derive the owning hospital from the
// stored document, never from a client-supplied value.
function isAboveGroupPath(groupPath) {
  return exists(groupPath)
    && (
      (get(groupPath).data.departmentId != null && isAboveDeptPath(get(groupPath).data.departmentId))
      || isHospitalAdmin(get(groupPath).data.hospitalId)
    );
}

// A brand-new group document must name its creator as its sole initial
// member, with the admin role -- this is what makes "creator becomes
// admin" a server-enforced fact rather than something the client merely
// claims. A group must always declare which hospital it belongs to, and
// the creator must actually be an admin of that hospital (or, if it's
// also being created under a department, that department's admin) --
// otherwise anyone could tag a group as belonging to a hospital they
// have no authority over. If a departmentId is given, its own stored
// hospitalId must match the group's declared hospitalId too, so a group
// can never be tagged with one hospital while secretly living under
// another hospital's department.
function isValidNewGroup() {
  return signedIn()
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.members.keys().hasOnly([request.auth.uid])
    && request.resource.data.members[request.auth.uid].role == 'admin'
    && request.resource.data.hospitalId is string
    && exists(hospitalDoc(request.resource.data.hospitalId))
    && (
      !('departmentId' in request.resource.data) || request.resource.data.departmentId == null
      || get(departmentDoc(request.resource.data.departmentId)).data.hospitalId == request.resource.data.hospitalId
    )
    && (
      isHospitalAdmin(request.resource.data.hospitalId)
      || (
        'departmentId' in request.resource.data && request.resource.data.departmentId != null
        && isDepartmentAdmin(request.resource.data.departmentId)
      )
    );
}

match /databases/{database}/documents {

  // ---- user profiles ----
  // Each signed-in user has exactly one profile doc, keyed by their own
  // uid. They can read and write only their own profile -- there is no
  // global role flag here (no cross-hospital super-admin exists in this
  // model), so there's nothing for one user to need to see or grant on
  // another user's profile via this collection. Per-hospital authority
  // lives entirely on `hospitals/{hospitalId}.admins` instead.
  match /users/{uid} {
    allow read: if signedIn() && request.auth.uid == uid;
    // role/displayName are denormalized into every chat message and
    // announcement this user sends (see wardsChatDisplayName() and
    // senderRole in wards.html) -- validate them here rather than trust
    // the client's maxlength attribute, which is UI-only and doesn't
    // stop a modified client from writing anything.
    allow create: if signedIn() && request.auth.uid == uid
      && (!('role' in request.resource.data) || request.resource.data.role in ['doctor', 'nurse', 'intern', 'student', 'student-nurse'])
      && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80))
      && !('opdHospitalId' in request.resource.data) && !('opdDepartment' in request.resource.data);
    // Two entirely separate ways this doc can be updated, never both at
    // once in the same write:
    //   (a) the user themselves, touching their own displayName/role --
    //       same validation as create, and explicitly forbidden from
    //       touching opdHospitalId/opdDepartment in this branch (self-
    //       service can't grant/change its own OPD department access).
    //   (b) a hospital admin, touching ONLY opdHospitalId/opdDepartment
    //       on ANY user's doc -- this is the entire "assigned by hospital
    //       admin" workflow made real: a user can never set their own OPD
    //       department, only an admin of the hospital being assigned can.
    allow update: if signedIn() && (
      (
        request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'email'])
        && (!('role' in request.resource.data) || request.resource.data.role in ['doctor', 'nurse', 'intern', 'student', 'student-nurse'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80))
        && (!('email' in request.resource.data) || request.resource.data.email is string)
      )
      || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opdHospitalId', 'opdDepartment'])
        && request.resource.data.opdHospitalId is string
        && isHospitalAdmin(request.resource.data.opdHospitalId)
        && (!('opdDepartment' in request.resource.data) || request.resource.data.opdDepartment == null || (request.resource.data.opdDepartment is string && request.resource.data.opdDepartment.size() <= 60))
      )
    );
    allow delete: if signedIn() && request.auth.uid == uid;
  }

  // Invite-by-email lookup (email -> uid). Not sensitive beyond the
  // mapping itself; a user may only write their own mapping (done once
  // at sign-up), and any signed-in user may look up a SPECIFIC email
  // they already know (needed so a group admin can resolve "invite this
  // email" client-side, via wardsFindUidByEmail's single .doc(key).get()
  // -- see wards.html).
  //
  // `allow read` used to cover this, but read = get + list, and an
  // unconstrained list on a collection keyed by lowercased email is a
  // straight PII dump: any signed-in account, any hospital or none, could
  // run `.collection('usersByEmail').get()` and receive every registered
  // user's email + uid across this whole shared multi-tenant project.
  // Every OTHER collection in this file that's ever looked up by a
  // specific known key (hospitals, wardGroups, departments, ...) already
  // has this exact split with the same reasoning in its own comments --
  // this collection was the one that got missed. The app never lists
  // this collection in bulk, so list is simply denied, same as those.
  match /usersByEmail/{emailKey} {
    allow get: if signedIn();
    allow list: if false;
    allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
  }

  // ---- hospitals (the tenancy root) ----
  // Any signed-in user may create a hospital and becomes its sole admin
  // (server-enforced by isValidNewHospital) -- this self-service creation
  // IS the bootstrap step; there is no manual "set superAdmin=true in the
  // console" process in this model. Only that hospital's own admin(s) can
  // read, update, or delete it afterward -- no cross-hospital visibility
  // at all, by design.
  match /hospitals/{hospitalId} {
    allow get: if isHospitalAdmin(hospitalId);
    // `allow list: if signedIn()` would NOT be per-document-filtered the
    // way the old comment here used to claim -- an unconstrained list rule
    // with no resource.data condition lets ANY signed-in user (any
    // hospital, or none) run an unfiltered `.collection('hospitals').get()`
    // and receive every hospital's name + full admins map (uids/emails)
    // in the whole multi-tenant project, a real cross-tenant leak. The app
    // never actually lists this collection in bulk -- it only ever reads a
    // specific hospital by an ID it already has (see `initWardsCloudSync`/
    // hospital-selection code in wards.html) -- so list is simply denied.
    allow list: if false;
    allow create: if isValidNewHospital();
    // `admins.size() > 0` blocks any update (including a co-admin removal,
    // see wardsRemoveCoAdmin in wards.html) that would leave the admins
    // map empty -- a hospital must always keep at least one admin. This is
    // server-side backstop for the same rule the app already enforces
    // client-side; it's a cheap, always-true-for-legitimate-writes check
    // since `admins` is a required field on every hospital doc, not a
    // full diff of what else changed (this rule already leaves every
    // other field open to an existing admin, by design -- see class
    // comment above on "existing admin's update is unrestricted").
    allow update: if isHospitalAdmin(hospitalId) && request.resource.data.admins.size() > 0;
    allow delete: if isHospitalAdmin(hospitalId);
  }

  // ---- departments ----
  match /departments/{deptId} {
    allow get: if isDepartmentAdmin(deptId) || isAboveDeptPath(deptId);
    // See the matching comment on hospitals/{hospitalId} above -- an
    // unconstrained `signedIn()` list rule would let any signed-in user
    // enumerate every department (name + admins map) across every
    // hospital. There is no in-app department-list UI yet, so list is
    // denied entirely; if that UI gets built, this should become
    // `resource.data.hospitalId == <a specific hospital the caller
    // administers>` matched against an actual `.where('hospitalId','==',
    // id)` query client-side, not a blanket allow.
    allow list: if false;
    allow create: if isValidNewDepartment();
    // hospitalId is locked on update (must match the existing value) --
    // otherwise a department admin could re-parent their own department
    // to a hospital they don't control (escaping that hospital's
    // oversight) or to one they don't belong to at all (spoofing a
    // relationship with it). Re-parenting isn't a supported operation.
    // See the matching `admins.size() > 0` comment on hospitals/{hospitalId}
    // above -- same backstop, same reasoning, a department must always keep
    // at least one admin too.
    allow update: if (isDepartmentAdmin(deptId) || isAboveDeptPath(deptId))
      && request.resource.data.hospitalId == resource.data.hospitalId
      && request.resource.data.admins.size() > 0;
    allow delete: if isAboveDeptPath(deptId); // deleting a whole department is hospital-admin-level only, not a department admin's own call

    // ---- department-wide text chat -- everyone actually working in the
    // department (any ward-group member under it, via
    // isDepartmentMember), plus its admins/hospital admin. Messages are
    // immutable once posted (no update/delete) -- simplest safe v1 for a
    // chat log; editing/retracting a message is a possible future
    // addition, not attempted here. ----
    match /chat/{msgId} {
      allow read: if isDepartmentMember(deptId) || isDepartmentAdmin(deptId) || isAboveDeptPath(deptId);
      allow create: if (isDepartmentMember(deptId) || isDepartmentAdmin(deptId) || isAboveDeptPath(deptId))
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // ---- department announcements -- one-way broadcast, same readers as
    // chat above, but posting is admin-only (a "bar," not a discussion). ----
    match /announcements/{annId} {
      allow read: if isDepartmentMember(deptId) || isDepartmentAdmin(deptId) || isAboveDeptPath(deptId);
      allow create: if (isDepartmentAdmin(deptId) || isAboveDeptPath(deptId))
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if isDepartmentAdmin(deptId) || isAboveDeptPath(deptId); // admins can retract an announcement
      // read receipts: any reader can touch ONLY the readBy map (nothing else),
      // same "simplest safe v1" trust level as the rest of this map -- a
      // member could in theory mark another uid as having read it, but
      // there's no confidentiality or ordering stake in that being exact.
      allow update: if (isDepartmentMember(deptId) || isDepartmentAdmin(deptId) || isAboveDeptPath(deptId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }
  }

  // ---- department membership index -- mirrors groupMemberships exactly
  // (see that collection's comment for the full reasoning): doc id
  // `${uid}_${deptId}`, written in the SAME batch as whatever action
  // already grants the user membership of a ward group tagged with that
  // department (wardsCreateGroup / wardsAcceptInvite in wards.html), so
  // whoever's allowed to make that group-membership change is allowed
  // here too. Exists purely so isDepartmentMember() above can do a cheap
  // exists() check instead of an un-expressible "is a member of any
  // group under this department" query. ----
  match /departmentMemberships/{membershipId} {
    allow read: if signedIn() && (
      resource.data.uid == request.auth.uid
      || isAboveDeptPath(resource.data.deptId)
    );
    allow list: if resource.data.uid == request.auth.uid;
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.deptId is string;
    allow delete: if signedIn() && resource.data.uid == request.auth.uid;
  }

  // ---- the read-side "my groups" index ----
  // Document id convention: `${uid}_${groupId}`. Only ever read via a
  // `where('uid','==', request.auth.uid)` query from the app (that's
  // what lets Firestore accept the `list` rule below); a hospital admin
  // may read entries for groups within their own hospital only (via
  // isAboveGroupPath, which re-derives the owning hospital from the
  // referenced group's own stored `hospitalId`).
  match /groupMemberships/{membershipId} {
    allow read: if signedIn() && (
      resource.data.uid == request.auth.uid
      || isAboveGroupPath(groupDoc(resource.data.groupId))
    );
    // `list` and `read` are separate rule types in Firestore -- the `read`
    // condition above does NOT govern list/query requests on its own, so
    // this needed its own condition mirroring it, not a blanket
    // `signedIn()`. This form (a plain resource.data equality check) is
    // what lets Firestore prove the app's actual
    // `.where('uid','==',request.auth.uid)` query (see initWardsCloudSync
    // in wards.html) is safe and allow it, while rejecting any query that
    // isn't constrained the same way -- a bare `.collection(
    // 'groupMemberships').get()` with no uid filter would be denied
    // outright, not silently filtered. Hospital/group admins looking up
    // a specific patient's memberships still go through `get`, unaffected.
    allow list: if resource.data.uid == request.auth.uid;
    // Only created/deleted as part of the *same batched write* that adds
    // or removes the uid from the corresponding group's `members` map --
    // so whoever is allowed to make that group change is allowed here too.
    // Third branch: a user accepting their OWN invite creates their OWN
    // membership-index entry (nobody above them does it for them, since
    // they aren't a member yet for isGroupAdminPath/isAboveGroupPath to
    // recognize). Gated on the exact same callerHasInviteFor() proof as
    // isValidInviteAccept on the wardGroups doc itself -- see that
    // function's comment for the full attack-scenario reasoning. Scoped
    // to `request.resource.data.uid == request.auth.uid` so this branch
    // can never be used to create a membership row for anyone else.
    allow create: if signedIn()
      && request.resource.data.uid is string
      && (
        isGroupAdminPath(groupDoc(request.resource.data.groupId))
        || isAboveGroupPath(groupDoc(request.resource.data.groupId))
        || (
          request.resource.data.uid == request.auth.uid
          && callerHasInviteFor(request.resource.data.groupId)
        )
      );
    allow delete: if signedIn()
      && (
        resource.data.uid == request.auth.uid // anyone can remove themselves (leave a group)
        || isGroupAdminPath(groupDoc(resource.data.groupId))
        || isAboveGroupPath(groupDoc(resource.data.groupId))
      );
  }

  // ---- the read-side "invites addressed to me" index -- see the schema
  // comment above and callerHasInviteFor()/isValidInviteAccept() for why
  // this needs to be a flat, equality-queryable collection rather than a
  // collection-group query over wardGroups/*/invites. ----
  match /pendingInvites/{inviteId} {
    allow get: if signedIn() && (
      resource.data.email == request.auth.token.email.lower()
      || isGroupAdminPath(groupDoc(resource.data.groupId))
      || isAboveGroupPath(groupDoc(resource.data.groupId))
    );
    // Same reasoning as groupMemberships' list rule above: constrained to
    // match the app's actual `.where('email','==', myEmail.toLowerCase())`
    // query (see wardsSubscribeMyPendingInvites in wards.html), not a
    // blanket `signedIn()` -- which would let any signed-in user enumerate
    // every pending invite's email address project-wide.
    allow list: if resource.data.email == request.auth.token.email.lower();
    // Only created as part of the SAME batched write that creates the
    // matching wardGroups/{groupId}/invites/{emailKey} doc (see
    // wardsInviteToGroup in wards.html) -- so whoever is allowed to make
    // that invite is allowed here too. Not cross-checked against the
    // sibling doc's content (batched writes don't let one write's rule
    // read another uncommitted write in the same batch); the sibling
    // doc's own create rule enforces its own invariants independently.
    allow create: if signedIn()
      && request.resource.data.email is string
      && (
        isGroupAdminPath(groupDoc(request.resource.data.groupId))
        || isAboveGroupPath(groupDoc(request.resource.data.groupId))
      );
    // Deleted by a group admin/above revoking an invite, or by the
    // invited user themselves declining/accepting their OWN invite
    // (never anyone else's -- pinned to their own verified token email).
    allow delete: if signedIn() && (
      resource.data.email == request.auth.token.email.lower()
      || isGroupAdminPath(groupDoc(resource.data.groupId))
      || isAboveGroupPath(groupDoc(resource.data.groupId))
    );
    allow update: if false; // no field of a pending invite is ever edited in place -- only created and deleted
  }

  // ---- Ward groups (single system -- patients within carry their own
  // `department` field rather than living in a department-specific
  // collection, so one ward group can hold patients from any mix of
  // General/ICU/Surgery/Pediatrics/Maternity) ----
  match /wardGroups/{groupId} {
    allow get: if isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
      || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
    // Same reasoning as hospitals/departments above: an unconstrained
    // `signedIn()` list rule would let any signed-in user enumerate every
    // ward group (name + members map) across every hospital in the
    // project -- a real cross-tenant leak, not just a within-hospital one.
    // The app never actually lists this collection in bulk; it discovers
    // "which groups am I in" via the separately-indexed, properly
    // uid-constrained groupMemberships collection below, then reads each
    // group by its known id. If a dept/hospital-admin "all groups I
    // administer" browser gets built later, give it a real query
    // constraint (e.g. `.where('hospitalId','==',id)`) matched by a rule
    // condition on that same field -- not a blanket allow.
    allow list: if false;
    allow create: if isValidNewGroup();
    // hospitalId AND departmentId are both locked on update (must match
    // their existing values) -- otherwise a group admin could re-parent
    // the group to a department belonging to a DIFFERENT hospital while
    // keeping hospitalId unchanged, handing that foreign department's
    // admin (via isAboveDeptPath, which trusts the department's own
    // hospitalId) read/write access to this group's patient data -- a
    // cross-hospital leak. Re-parenting isn't a supported operation;
    // create a new group under the new department/hospital instead.
    // Second branch (isValidInviteAccept) is the narrow, provably-safe
    // carve-out that lets a NOT-YET-a-member user modify this doc at all:
    // accepting their own pending invite. It does not need its own
    // hospitalId/departmentId lock repeated here -- its internal
    // diff().affectedKeys().hasOnly(['members']) check already forbids
    // touching those fields (or any field besides `members`) at all, a
    // strictly tighter guarantee than the explicit equality checks the
    // first branch uses.
    allow update: if (
        (isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
          || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId)))
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.departmentId == resource.data.departmentId
      )
      || isValidInviteAccept(/databases/$(database)/documents/wardGroups/$(groupId), groupId);
    allow delete: if isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
      || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));

    match /patients/{patientId} {
      allow read, write: if isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
    }
    match /invites/{emailKey} {
      allow read: if signedIn() && (
        resource.data.email == request.auth.token.email.lower()
        || isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId))
      );
      // Deliberately still not queried in bulk anywhere in the app -- an
      // invited user has no standing membership to browse this
      // subcollection directly, which is exactly why pendingInvites
      // (top-level, flat, equality-queryable by email) exists. Left
      // denied outright rather than a blanket `signedIn()` allow, which
      // would let any signed-in user enumerate every pending invite's
      // email address across every ward group.
      allow list: if false;
      // emailKey must equal the invite's own declared (lowercased) email
      // -- this is what lets isValidInviteAccept and callerHasInviteFor
      // trust "a doc exists at .../invites/$(myEmail.lower())" as
      // sufficient proof of invitation, without separately re-checking
      // the doc's `email` field content.
      allow create: if (isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
          || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId)))
        && request.resource.data.email == emailKey;
      // Deleted by a group admin/above revoking a not-yet-accepted
      // invite, OR by the invited user themselves -- declining, or as
      // part of the same batch that accepts it (see isValidInviteAccept)
      // -- but only ever their OWN invite: resource.data.email is pinned
      // to their own verified token email, never a client-supplied uid
      // or someone else's address.
      allow delete: if isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || resource.data.email == request.auth.token.email.lower();
    }

    // Append-only audit trail -- any member can add an entry (Wards writes
    // one for patient add/remove, a new reading, and an escalation logged),
    // but nobody can edit or erase history: only read by a group admin or
    // above, and delete restricted to that group's owning hospital's
    // admin specifically (not a plain group/department admin), matching
    // this collection's "audit trail" purpose -- no global super-admin
    // exists to fall back to in this model.
    match /auditLog/{entryId} {
      allow read: if isGroupAdminPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
      allow create: if isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
      allow update: if false;
      allow delete: if isHospitalAdmin(get(/databases/$(database)/documents/wardGroups/$(groupId)).data.hospitalId);
    }

    // ---- this ward group's own text chat -- same membership check as
    // the patients subcollection above, immutable messages (no
    // update/delete) for the same "simplest safe v1" reasoning as
    // departments/{deptId}/chat. ----
    match /chat/{msgId} {
      allow read: if isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
        || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId));
      allow create: if (isMemberPath(/databases/$(database)/documents/wardGroups/$(groupId))
          || isAboveGroupPath(/databases/$(database)/documents/wardGroups/$(groupId)))
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }
  }

  // ---- OPD (outpatient) -- one patient record per hospital, shared
  // across every department, with every department's visits visible
  // together (see wards.html's OPD module and isOpdMember()/
  // opdMemberDepartment() above for the full design rationale). Nested
  // under hospitals/{hospitalId} (like wardGroups/{groupId}/patients) so
  // hospital scoping is structural -- the path segment IS the hospital
  // id -- rather than a query-time filter a `list` rule can't validate.
  match /hospitals/{hospitalId}/opdPatients/{patientId} {
    allow get, list: if isOpdMember(hospitalId) || isHospitalAdmin(hospitalId);
    allow create: if (isOpdMember(hospitalId) || isHospitalAdmin(hospitalId))
      && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
      && (!('age' in request.resource.data) || request.resource.data.age == null || (request.resource.data.age is number && request.resource.data.age >= 0 && request.resource.data.age <= 130))
      && (!('gender' in request.resource.data) || request.resource.data.gender is string)
      && (!('mrn' in request.resource.data) || request.resource.data.mrn is string)
      // mrnKey is a normalized (trimmed+uppercased) copy of mrn, written
      // by the client so it can query for exact-MRN duplicates before
      // creating a new patient (see opdFindDuplicates in wards.html) --
      // just type-validated here, not re-derived server-side, since it's
      // a lookup convenience, not a security boundary.
      && (!('mrnKey' in request.resource.data) || request.resource.data.mrnKey is string);
    // Demographic corrections only -- createdBy/createdAt are permanent
    // once set (never re-attributable to someone else after the fact),
    // and only the original creator or this hospital's admin may correct
    // a patient's own details at all.
    allow update: if (resource.data.createdBy == request.auth.uid || isHospitalAdmin(hospitalId))
      && request.resource.data.createdBy == resource.data.createdBy
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
    // No client-side delete -- a hospital admin correcting a genuine
    // duplicate/test entry is a rare enough case to handle by hand
    // (console/support) rather than build a delete path for patient
    // identity records this early.
    allow delete: if false;

    // Visits are the actual clinical content (diagnosis/plan/follow-up).
    // Read is hospital-wide (isOpdMember of ANY department, or the
    // hospital admin) -- this is what makes "an ENT doctor can see a
    // patient's prior cardiology visit" true server-side, not just a
    // client-side rendering choice. Create is scoped to the writer's OWN
    // assigned department (opdMemberDepartment(), which only a hospital
    // admin can ever set -- see users/{uid} above) unless they're the
    // hospital admin, so a user assigned to ENT cannot file a Cardiology
    // visit no matter what the client sends. Immutable once created (no
    // update) -- a wrong entry needs a correction workflow (amendments
    // with visible history), not a silent overwrite; that's a follow-up,
    // not this pass. Hospital admin may delete for genuine corrections.
    match /visits/{visitId} {
      allow get, list: if isOpdMember(hospitalId) || isHospitalAdmin(hospitalId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.department is string && request.resource.data.department.size() > 0 && request.resource.data.department.size() <= 60
        && request.resource.data.date is string
        && (!('chiefComplaint' in request.resource.data) || (request.resource.data.chiefComplaint is string && request.resource.data.chiefComplaint.size() <= 500))
        && (!('diagnosis' in request.resource.data) || (request.resource.data.diagnosis is string && request.resource.data.diagnosis.size() <= 2000))
        && (!('plan' in request.resource.data) || (request.resource.data.plan is string && request.resource.data.plan.size() <= 2000))
        && (!('followUpDate' in request.resource.data) || request.resource.data.followUpDate is string)
        && (
          isHospitalAdmin(hospitalId)
          || (isOpdMember(hospitalId) && request.resource.data.department == opdMemberDepartment())
        );
      allow update: if false;
      allow delete: if isHospitalAdmin(hospitalId);

      // The correction workflow promised above: a visit itself never
      // changes, but an amendment can be attached recording what should
      // have been written and why. Read side renders original + every
      // amendment in order rather than silently merging them, so nothing
      // is ever hidden -- see opdVisitCardsHtml() in wards.html. Create
      // is gated by the SAME department-match rule as the parent visit
      // (re-derived from the parent visit's own stored `department`,
      // never client-supplied) -- an ENT-assigned user can't amend a
      // Cardiology visit any more than they could have created one.
      // Amendments are themselves immutable (a wrong amendment gets its
      // own further amendment, never a silent edit).
      match /amendments/{amendmentId} {
        allow get, list: if isOpdMember(hospitalId) || isHospitalAdmin(hospitalId);
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
          && (!('chiefComplaint' in request.resource.data) || (request.resource.data.chiefComplaint is string && request.resource.data.chiefComplaint.size() <= 500))
          && (!('diagnosis' in request.resource.data) || (request.resource.data.diagnosis is string && request.resource.data.diagnosis.size() <= 2000))
          && (!('plan' in request.resource.data) || (request.resource.data.plan is string && request.resource.data.plan.size() <= 2000))
          && (!('followUpDate' in request.resource.data) || request.resource.data.followUpDate is string)
          && (
            isHospitalAdmin(hospitalId)
            || (
              isOpdMember(hospitalId)
              && exists(/databases/$(database)/documents/hospitals/$(hospitalId)/opdPatients/$(patientId)/visits/$(visitId))
              && opdMemberDepartment() == get(/databases/$(database)/documents/hospitals/$(hospitalId)/opdPatients/$(patientId)/visits/$(visitId)).data.department
            )
          );
        allow update: if false;
        allow delete: if isHospitalAdmin(hospitalId);
      }
    }
  }

  // Default deny for anything not explicitly matched above.
  match /{document=**} {
    allow read, write: if false;
  }
}

}
